{
  "name": "subscription-management",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "app/*"
  ],
  "description": "> A full-stack subscription management application that helps users track recurring subscriptions, understand their spending, and avoid unwanted renewals.",
  "directories": {
    "doc": "docs"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start:frontend": "cd app/web && npm run dev",
    "start:backend": "cd app/api && npm run start",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\""
  }
}
