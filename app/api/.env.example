NODE_ENV=development
PORT=4000
# Supabase > Connect > Connection string > Session pooler (contains the database password)
DATABASE_URL=
# https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...). Never the secret/service-role key.
SUPABASE_PUBLISHABLE_KEY=
# Origin of the React app, exact match
CORS_ORIGIN=http://localhost:3000
# Resend API key (resend.com > API Keys) and the sender. While testing: Subscription Manager <onboarding@resend.dev>
RESEND_API_KEY=
EMAIL_FROM=
# Reverse proxies in front of the API; 0 in development. Needed so rate limits count real client addresses.
TRUST_PROXY_HOPS=0
# Scheduled jobs (Story 4). The job_runner role's connection string (Session pooler, user job_runner.<project-ref>),
# with the password you set by ALTER ROLE job_runner PASSWORD after running migrations/003_reminders.sql.
JOB_DATABASE_URL=
# Shared secret for /api/v1/internal/jobs/*. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_JOB_SECRET=
# Signs the monthly email's unsubscribe link (Story 10). Generate a different value the same way.
EMAIL_LINK_SECRET=
# Optional, for the database security tests (npm test -w api): existing user ids, taken from Authentication > Users.
# TEST_USER_A_ID=
# TEST_USER_B_ID=
